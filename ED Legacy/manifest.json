{
  "manifest_version": 3,
  "name": "ED Legacy",
  "description": "Ramène à la joie votre ENT Ecole Directe ! Il y a suffisamment de dépression avec les cours, par pitié ne nous en ajoutez pas encore plus avec cette interface.",
  "version": "0.0.1",
  "icons": {
    "64": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ecoledirecte.com/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "ed-legacy@oeildelynx.com",
    "data_collection_permissions": {
      "required": [
        "none"
      ]
    },
    "strict_min_version": "58.0"
  }
}
}